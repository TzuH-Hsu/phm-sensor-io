---
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -readability-identifier-length,
  -misc-include-cleaner,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once
WarningsAsErrors: '*'
# This repository's headers only: the public ones under include/phm/ and the
# private ones under src/ and tests/. Third-party headers in build/_deps/ do
# not match.
HeaderFilterRegex: '.*/(include/phm|src|tests)/.*'
FormatStyle: file
...
