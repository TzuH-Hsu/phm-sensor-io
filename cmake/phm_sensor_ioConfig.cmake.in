#
# Package configuration file of the phm_sensor_io library, installed as
# <prefix>/<libdir>/cmake/phm_sensor_io/phm_sensor_ioConfig.cmake and read by
# find_package(phm_sensor_io CONFIG). It defines the imported target
# phm_sensor_io::phm_sensor_io.

@PACKAGE_INIT@

# Third-party dependencies of the exported target are found here, before the
# targets file is read, so that a consumer's find_package() fails with the name
# of the missing dependency. The library has none yet. When the third-party
# Modbus library is added, find it here, for example:
#
#   include(CMakeFindDependencyMacro)
#   find_dependency(<package>)

include("${CMAKE_CURRENT_LIST_DIR}/phm_sensor_ioTargets.cmake")

check_required_components(phm_sensor_io)
